# Supabase PostgreSQL. Keep the real URL in api/.env and Railway Variables.
DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# Authentication
JWT_SECRET=gere-uma-chave-secreta-forte
# Email via Gmail SMTP (no custom domain required). Requires a Google App Password.
GMAIL_USER=seu-endereco@gmail.com
GMAIL_APP_PASSWORD=sua-senha-de-app-do-google
# The From address must match GMAIL_USER when using Gmail SMTP.
EMAIL_FROM=Zona Vermelha <seu-endereco@gmail.com>
# Optional Resend fallback when Gmail variables are not configured.
RESEND_API_KEY=re_xxxxxxxxx
# Optional public URL override for links sent by email.
# Render supplies RENDER_EXTERNAL_URL automatically when omitted.
API_PUBLIC_URL=https://SEU-SERVICO.onrender.com

# The hosting provider supplies PORT; 3000 is for local development.
PORT=3000

# Route planning
OSRM_BASE_URL=https://router.project-osrm.org
# Temporary token for risk report moderation; use a strong secret and never publish it.
ROUTE_ADMIN_TOKEN=troque-por-um-segredo-forte-com-mais-de-32-caracteres
