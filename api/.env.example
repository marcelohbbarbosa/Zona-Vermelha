# Supabase PostgreSQL. Keep the real URL in api/.env and Railway Variables.
DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# Authentication and email (Resend)
JWT_SECRET=gere-uma-chave-secreta-forte
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=Zona Vermelha <no-reply@seudominio.com>
# Public Railway domain for links sent by email.
API_PUBLIC_URL=https://SEU-DOMINIO-PUBLICO.up.railway.app

# Railway supplies PORT automatically; 3000 is for local development.
PORT=3000

# Private service-to-service address, only inside the same Railway project/environment.
# Clients should use http://zona-vermelha.railway.internal:$PORT

# Route planning
OSRM_BASE_URL=https://router.project-osrm.org
# Temporary token for risk report moderation; use a strong secret and never publish it.
ROUTE_ADMIN_TOKEN=troque-por-um-segredo-forte-com-mais-de-32-caracteres
