# Postgres. Em produção, use a URL interna do banco no Render.
DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# Auth e envio de e-mail (Resend)
JWT_SECRET=gere-uma-chave-secreta-forte
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=Zona Vermelha <no-reply@seudominio.com>
API_PUBLIC_URL=https://zona-vermelha-backend.onrender.com

# Porta local; o Render fornece PORT automaticamente.
PORT=3000
